# ======================
# Database
# ======================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=logistics
POSTGRES_PASSWORD=logistics
POSTGRES_DB=logistics

DATABASE_URL=postgresql+psycopg://logistics:logistics@postgres:5432/logistics


# ======================
# Kafka
# ======================

KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

KAFKA_TRIPS_TOPIC=taxi-trips
KAFKA_FEATURES_TOPIC=taxi-features


# ======================
# MLflow
# ======================

MLFLOW_HOST=mlflow
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000


# ======================
# Flink
# ======================

JOBMANAGER_HOST=jobmanager
JOBMANAGER_RPC_PORT=6123
FLINK_REST_PORT=8081
FLINK_SQL_PORT=8083


# ======================
# API
# ======================

API_PORT=8000
